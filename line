<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>MiniSnap</title>
<style>
body { font-family: sans-serif; background:#111; color:#fff; margin:0; }
header { padding:12px; font-weight:bold; background:#1e1e1e; }
.container { padding:12px; }
.card { background:#1e1e1e; padding:10px; margin-bottom:10px; border-radius:10px; }
button { padding:10px; border:none; border-radius:8px; margin-top:8px; }
video, img { width:100%; border-radius:10px; margin-top:10px; }
#alert { background:#ff4444; padding:10px; border-radius:10px; margin-top:12px; }
</style>
</head>
<body>

<header>MiniSnap（SNS風デモ）</header>

<div class="container">

<div class="card">
<p>あなたへのおすすめ</p>
<button onclick="viewPost('猫フィルター')">猫フィルターを見る</button>
<button onclick="viewPost('盛れるライト')">盛れるライトを見る</button>
</div>

<div class="card">
<p>📸 フィルターを使う（カメラ許可が必要）</p>
<button onclick="startCamera()">カメラを許可</button>
<video id="video" autoplay playsinline></video>
<canvas id="canvas" style="display:none;"></canvas>
<button onclick="snap()">撮影</button>
<img id="photo"/>
</div>

<div class="card">
<p>📍 位置情報</p>
<button onclick="getLocation()">位置を取得</button>
<p id="location"></p>
</div>

<div class="card">
<p>🧠 あなたのデータ</p>
<p id="data"></p>
</div>

<div id="alert" style="display:none;"></div>

</div>

<script>
/* --- クッキーでユーザー識別 --- */
function getUserId(){
let match = document.cookie.match(/user_id=([^;]+)/);
if(match) return match[1];

let id = "user_" + Math.random().toString(36).substring(2,10);
document.cookie = "user_id=" + id + "; path=/; max-age=86400";
return id;
}
const userId = getUserId();

/* --- 閲覧履歴（localStorage） --- */
function viewPost(name){
let history = JSON.parse(localStorage.getItem("history") || "[]");
history.push(name);
localStorage.setItem("history", JSON.stringify(history));
updateData();
}

/* --- カメラ --- */
async function startCamera(){
const stream = await navigator.mediaDevices.getUserMedia({ video:true });
document.getElementById("video").srcObject = stream;
}

function snap(){
const video = document.getElementById("video");
const canvas = document.getElementById("canvas");
canvas.width = video.videoWidth;
canvas.height = video.videoHeight;
canvas.getContext("2d").drawImage(video,0,0);
document.getElementById("photo").src = canvas.toDataURL("image/png");
}

/* --- 位置情報 --- */
function getLocation(){
navigator.geolocation.getCurrentPosition(pos=>{
document.getElementById("location").textContent =
pos.coords.latitude + ", " + pos.coords.longitude;
});
}

/* --- データ表示 --- */
function updateData(){
let history = JSON.parse(localStorage.getItem("history") || "[]");
document.getElementById("data").innerHTML =
"ユーザーID: " + userId + "<br>" +
"閲覧履歴: " + history.join(", ");
}
updateData();

/* --- ネタばらし --- */
setTimeout(()=>{
document.getElementById("alert").style.display="block";
どういう仕組みか解説して
document.getElementById("alert").innerHTML = `
⚠️ セキュリティデモ<br><br>
このサイトでは以下が行われました：<br>
・あなたを識別するIDを保存（クッキー）<br>
・閲覧履歴を記録（localStorage）<br>
・あなたの許可によりカメラ・位置情報を取得<br><br>
実際の悪質サイトではこれらが外部送信される可能性があります
`;
}, 8000);
</script>

</body>
</html>
